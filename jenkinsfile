
pipeline {
    agent any

    environment {
        IMAGE = "devops-site"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/abrarulhaqhaq04-stack/devops-site-end-to-end_original.git'
            }
        }

        stage('Build') {
            steps {
             bat '"C:\\Users\\abrar ul haq\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" build -t devops-site:%BUILD_NUMBER% .'
            }
        }

       stage('Login & Push') {
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'dockerhub-credentials',
                usernameVariable: 'DOCKER_USERNAME',
                passwordVariable: 'DOCKER_PASSWORD'
            )
        ]) {
            bat '''
                echo %DOCKER_PASSWORD% | "C:\\Users\\abrar ul haq\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" login -u %DOCKER_USERNAME% --password-stdin
                "C:\\Users\\abrar ul haq\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" push %DOCKER_IMAGE%:%BUILD_NUMBER%
            '''
        }
    }
}

        stage('Deploy') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'DOCKERHUB_CRAD',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    bat '''
                        docker stop %IMAGE% 2>NUL
                        docker rm %IMAGE% 2>NUL

                        docker run -d ^
                            --name %IMAGE% ^
                            --restart unless-stopped ^
                            -p 5000:5000 ^
                            %DOCKER_USER%/%IMAGE%:%VERSION%
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Build ${env.VERSION} deployed successfully."
        }

        failure {
            echo "Pipeline failed. Check the Jenkins logs."
        }

        always {
        bat '"C:\\Users\\abrar ul haq\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" logout || exit /b 0'
    
        }
    }
}

