pipeline {
    agent any

    environment {
        DOCKER = "C:\\Users\\abrar ul haq\\AppData\\Local\\Programs\\Docker\\DockerDesktop\\resources\\bin\\docker.exe"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/abrarulhaqhaq04-stack/devops-site-end-to-end_original.git'
            }
        }

        stage('Test Docker') {
            steps {
                bat """
                    "${DOCKER}" --version
                    echo ===== FILES IN WORKSPACE =====
                    dir
                """
            }
        }

        stage('Check Dockerfile') {
            steps {
                bat """
                    if not exist Dockerfile (
                        echo Dockerfile NOT FOUND
                        exit /b 1
                    )
                    echo Dockerfile FOUND
                """
            }
        }

        stage('Build') {
            steps {
                bat """
                    "${DOCKER}" build -t devops-site:latest .
                """
            }
        }

        stage('Login & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat """
                        echo %DOCKER_PASSWORD% | "${DOCKER}" login -u %DOCKER_USERNAME% --password-stdin
                        "${DOCKER}" tag devops-site:latest %DOCKER_USERNAME%/devops-site:latest
                        "${DOCKER}" push %DOCKER_USERNAME%/devops-site:latest
                    """
                }
            }
        }
    }

    post {
        always {
            bat """
                "${DOCKER}" logout
            """
        }
    }
}
