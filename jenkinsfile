```groovy
pipeline {
    agent any

    environment {
        IMAGE = "devops-site"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/abrarulhaqhaq04-stack/devops-site-end-to-end_original.git'
            }
        }

        stage('Build') {
            steps {
                script {
                    def VERSION = new Date().format("yyyyMMddHHmm")
                    env.VERSION = VERSION
                }

                bat "docker build -t %IMAGE%:%VERSION% ."
            }
        }

        stage('Login & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'DOCKERHUB_CRAD',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    bat '''
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin

                        docker tag %IMAGE%:%VERSION% %DOCKER_USER%/%IMAGE%:%VERSION%

                        docker push %DOCKER_USER%/%IMAGE%:%VERSION%
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'DOCKERHUB_CRAD',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    bat '''
                        docker stop %IMAGE% 2>NUL
                        docker rm %IMAGE% 2>NUL

                        docker run -d ^
                            --name %IMAGE% ^
                            --restart unless-stopped ^
                            -p 5000:5000 ^
                            %DOCKER_USER%/%IMAGE%:%VERSION%
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Build ${env.VERSION} deployed successfully."
        }

        failure {
            echo "Pipeline failed. Check the Jenkins logs."
        }

        always {
            bat 'docker logout'
        }
    }
}
```
