pipeline {

    agent any

    environment {
        DOCKER = 'C:\\Users\\abrar ul haq\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        DOCKER_IMAGE = 'abrar33001/devops-site'
        CONTAINER_NAME = 'devops-site'
    }

    stages {

        stage('Test Docker') {
            steps {
                bat '"C:\\Users\\abrar ul haq\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" --version'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '"C:\\Users\\abrar ul haq\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" build -t %DOCKER_IMAGE%:%BUILD_NUMBER% .'
            }
        }

        stage('Login & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat '''
                        echo %DOCKER_PASSWORD% | "%DOCKER%" login -u %DOCKER_USERNAME% --password-stdin
                        "%DOCKER%" push %DOCKER_IMAGE%:%BUILD_NUMBER%
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                bat '''
                    "%DOCKER%" stop %CONTAINER_NAME% || exit /b 0
                    "%DOCKER%" rm %CONTAINER_NAME% || exit /b 0
                    "%DOCKER%" run -d --name %CONTAINER_NAME% -p 8080:80 %DOCKER_IMAGE%:%BUILD_NUMBER%
                '''
            }
        }
    }

    post {
        always {
            bat '"C:\\Users\\abrar ul haq\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" logout || exit /b 0'
        }
    }
}
